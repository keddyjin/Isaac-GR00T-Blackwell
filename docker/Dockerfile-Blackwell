# Build cmd for x86_64: bash docker/build-Blackwell.sh -f docker/Dockerfile-Blackwell
# NOTE: if using base image of cuda:12.8.0-devel-ubuntu22.04 from original repo, 
#  will stuck at iteration 10 and stuck for multi GPUs on RTX 6K;
#  if using base image of pytorch:25.03-py3, 
#  will stuck at the beginning for multi GPUs and face CUDA error about flash-attn on RTX 6K

FROM nvcr.io/nvidia/pytorch:25.04-py3

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute

# System dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked <<EOF
set -e
apt-get update
apt-get install -y --no-install-recommends \
    build-essential \
    git \
    git-lfs \
    curl \
    wget \
    software-properties-common \
    ffmpeg

python -m pip install --upgrade pip setuptools wheel
EOF

WORKDIR /workspace

# Install Python dependencies from lockfile
# The wheels/ dir must be present before `uv sync` because pyproject.toml
# references them as path sources for aarch64 flash-attn and torchcodec.
COPY pyproject.toml uv.lock ./
COPY scripts/deployment/dgpu/wheels/ ./scripts/deployment/dgpu/wheels/

# Install the gr00t project itself
COPY . .
RUN mv pyproject.toml pyproject.toml.bak && cp pyproject-Blackwell.toml pyproject.toml && pip install -e .

# EGL/Vulkan setup for headless rendering (MuJoCo, PyOpenGL)
RUN apt-get update && apt-get install -y --no-install-recommends libegl1
RUN mkdir -p /usr/share/glvnd/egl_vendor.d && \
    cat >/usr/share/glvnd/egl_vendor.d/10_nvidia.json <<'EOF'
{
    "file_format_version" : "1.0.0",
    "ICD" : {
        "library_path" : "libEGL_nvidia.so.0"
    }
}
EOF

RUN mkdir -p /usr/share/vulkan/icd.d && \
    cat >/usr/share/vulkan/icd.d/nvidia_icd.json <<'EOF'
{
    "file_format_version": "1.0.0",
    "ICD": {
        "library_path": "libGLX_nvidia.so.0",
        "api_version": "1.2.140"
    }
}
EOF

ENV MUJOCO_GL="egl" \
    PYOPENGL_PLATFORM="egl" \
    __EGL_VENDOR_LIBRARY_FILENAMES="/usr/share/glvnd/egl_vendor.d/10_nvidia.json"

# torchcodec and flash-attn for aarch64 are installed from prebuilt wheels
# by `uv sync` above via pyproject.toml path sources — no source build needed.

CMD ["/bin/bash"]

